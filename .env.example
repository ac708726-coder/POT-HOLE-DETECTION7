# Copy to .env and adjust. Never commit the real .env — it is git-ignored.
# The app reads plain environment variables; load this file with your process
# manager (systemd EnvironmentFile, docker --env-file, direnv, ...).

# --- Application paths -------------------------------------------------------
# Detection weights. Keep the model outside the app directory in production so
# a redeploy cannot replace it by accident.
POTHOLE_MODEL_PATH=models/best.pt
# SQLite file holding accounts and detection history. Put this on a volume that
# survives redeploys, and back it up (scripts/backup_database.py).
POTHOLE_DATABASE_PATH=database/potholes.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
POTHOLE_LOG_LEVEL=INFO

# Generate a private random value of at least 32 bytes for persistent sign-in.
# Leave blank for session-only login. On Cloud, set this in App settings > Secrets.
DIVOT_COOKIE_SIGNING_KEY=

# --- Streamlit, production values -------------------------------------------
# Never render tracebacks in the browser; they leak paths and code. Errors are
# still written to the log with a reference id.
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=none
# No terminal is attached to a deployed process.
STREAMLIT_SERVER_HEADLESS=true
# Cross-origin and XSRF protection are on by default. Leave them on; if the app
# sits behind a reverse proxy, forward the original Host header instead of
# turning these off.
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=false
